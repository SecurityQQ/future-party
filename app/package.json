{
  "name": "zodiac-rangers",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -p 4400",
    "site": "python3 -I ../hub/site.py && find public -mindepth 1 -maxdepth 1 ! -name app -exec rm -rf {} + && cp -R ../site/. public/",
    "build": "npm run site && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "sync-presets": "bun scripts/sync-presets.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "ai": "^7.0.173",
    "next": "^16.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
