# Copy to .env.local and fill in. Server-only values have no NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # supabase projects api-keys --project-ref <ref>
DATABASE_URL=postgresql://postgres.<ref>:<url-encoded password>@aws-1-us-east-1.pooler.supabase.com:5432/postgres
VARG_API_KEY=varg_...                        # image generation (falls back to ~/.varg/credentials locally)
ADMIN_KEY=<random>                           # opens /admin?key=...
# AI Gateway: on Vercel the OIDC token is automatic; locally run `vercel env pull` or set AI_GATEWAY_API_KEY.
# Email login codes (Resend). Without a key, preview and local builds show the code on the page; production says email login is off.
RESEND_API_KEY=re_...
EMAIL_FROM="The Future 2050 <you@your-verified-domain>"   # must be on a domain verified in Resend
