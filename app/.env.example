# Copy to .env.local and fill in. The app has no database since the party ended (lib/frozen.json).
# AI Gateway, for Fable's readings: on Vercel the OIDC token is automatic; locally run `vercel env pull` or set AI_GATEWAY_API_KEY.
# AI_PAUSED=false                          # Fable's models are off unless this is set (lib/paused.ts); the templates answer
# FABLE_MODEL=anthropic/claude-fable-5.2   # optional: the model Fable tries first
