.DS_Store
node_modules/

# HyperFrames local state and caches (hold absolute local paths)
video/.hyperframes/
video/.thumbnails/

# Renders are published as GitHub release assets (the 1080p master is over GitHub's 100 MB file limit)
video/renders/

# QA frames from review passes
video/snapshots/

# Re-fetchable from Wikimedia Commons: tools/fetch_picks.py and tools/commons_candidates.py
video/assets/raw/
video/assets/candidates/
video/assets/candidates-v2/
video/assets/candidates-v2b/

# The Roast (HyperFrames project): renders and QA frames, same rules as video/
roast/.hyperframes/
roast/.thumbnails/
roast/renders/
roast/snapshots/

# Soundboard: downloaded Dirt-Samples audio and the offline build that embeds it.
# Dirt-Samples has no licence file, so its audio is streamed, never committed: python3 -I soundboard/build.py --offline
soundboard/.cache/
soundboard/dist/contact2050-offline.html

# The website: hub/site.py writes it, Vercel builds it from the repo on every deploy
site/
.vercel/

# Imagined Futures (concept-art/): original-size pictures and the fxtwitter cache are re-fetchable
# with python3 -I concept-art/fetch.py; thumbs/ and tweets.json are committed
concept-art/images/
concept-art/.cache/
# the 11 MB single-file copy: python3 -I concept-art/build.py writes it from thumbs/
concept-art/dist/

# Six Facts, the show reel (HyperFrames project): renders and QA frames, same rules as video/.
# The NASA footage and the Further slide cuts are re-fetchable: python3 -I showreel/tools/fetch_footage.py
# and python3 -I showreel/tools/prepare_assets.py. The trimmed score (CC BY 4.0) is committed.
showreel/.hyperframes/
showreel/.thumbnails/
showreel/.waveform-cache/
showreel/renders/
showreel/snapshots/
showreel/assets/footage/
showreel/assets/further/
showreel/assets/music/_call-to-adventure-full.mp3
