# Upload only the party app (app/, the Vercel project's root directory) and what hub/site.py reads to write the
# party site, which `npm run site` copies into app/public/ on every build
/*
!/app
/app/node_modules
/app/.next
/app/.vercel
/app/.env*
/app/data
/app/scripts
/app/supabase
/app/tsconfig.tsbuildinfo
/app/public/*
!/app/public/app
!/hub
!/books
!/tweets
!/music
!/video
!/soundboard
!/programme
!/reel
!/mirror
!/concept-art
!/wall
!/mars3d
!/slides
!/vibes
/vibes/*
!/vibes/tokens.css
!/vibes/assets
/video/*
!/video/dist
# the Big Wall shows Further's photos (site.py copies only the ones in wall/dist/manifest.json)
!/video/assets
/video/assets/*
!/video/assets/photos
/tweets/avatars
/soundboard/.cache
/soundboard/dist/contact2050-offline.html
/mirror/vendor
/concept-art/images
/concept-art/.cache
/concept-art/dist
/mars3d/raw
